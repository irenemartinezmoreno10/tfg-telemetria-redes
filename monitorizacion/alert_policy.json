          "uid": "ag086mfy4wbuof",
          "title": "Interfaz caída (gNMI)",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "influxdb",
              "model": {
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "query": "from(bucket: \"telemetria\")\r\n  |> range(start: -24h)\r\n  |> filter(fn: (r) => r._measurement == \"estado\")\r\n  |> last()\r\n  |> map(fn: (r) => ({r with _value: if r._value == \"down\" then 1.0 else 0.0}))\r\n  |> keep(columns: [\"_time\", \"_value\", \"source\"])\r\n",
                "refId": "A"
